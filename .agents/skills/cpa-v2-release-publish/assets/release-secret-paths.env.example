# CPA_V2 release secret path config template.
# Copy to ~/.config/cpa-v2-release/release-secret-paths.env and edit paths for the local machine.
# Keep credentials in user-level paths, never inside the repository.
# Store paths and public identifiers only. Do not paste private key, password, token, or Apple credential contents here.

CPA_V2_REPO="/absolute/path/to/CPA_V2"
GITHUB_REPO="UnityX103/CPA_V2"
CNB_REPO="nanzhaigame-xpy/CPA_V2"
CPA_UPDATER_ENDPOINT="https://cnb.cool/nanzhaigame-xpy/CPA_V2/-/releases/latest/download/latest.json"
CPA_UPDATER_FALLBACK_ENDPOINT="https://github.com/UnityX103/CPA_V2/releases/latest/download/latest.json"
RUST_TOOLCHAIN_BIN="$HOME/.rustup/toolchains/stable-aarch64-apple-darwin/bin"

# Tauri updater signing. These files are sensitive except the public key.
CPA_UPDATER_PRIVATE_KEY_PATH="$HOME/.tauri/cpa-updater.key"
CPA_UPDATER_PASSWORD_PATH="$HOME/.tauri/cpa-updater.password"
CPA_UPDATER_PUBLIC_KEY_PATH="$HOME/.tauri/cpa-updater.key.pub"

# GitHub git transport.
GITHUB_SSH_HOST="github.com"
GITHUB_SSH_KEY_PATH="$HOME/.ssh/id_ed25519_github"

# CNB Release OpenAPI token. The file must be mode 600 and include repo-release:rw.
CNB_TOKEN_FILE="$HOME/.config/cpa-v2-release/cnb-release-token"
export CNB_TOKEN="$(cat "$CNB_TOKEN_FILE")"

# Legacy self-hosted Nanzhai update CDN. Do not use for new releases.
REMOTE_NANZHAI_HOST="139.159.233.218"
REMOTE_NANZHAI_USER="root"
REMOTE_NANZHAI_SSH_KEY_PATH="$HOME/.ssh/KeyPair-bec2.pem"
REMOTE_NANZHAI_UPDATE_ROOT="/srv/cpa-updates/public/cpa"
REMOTE_NANZHAI_DOMAIN="updates.nanzhaigame.cn"

# Optional Apple signing/notarization. Empty means unavailable.
APPLE_DEVELOPER_ID_APPLICATION=""
APPLE_NOTARYTOOL_PROFILE=""
