{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌宠番茄钟",
  "version": "0.1.1",
  "identifier": "com.nanzhai.cpa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌宠番茄钟",
        "width": 249,
        "height": 171,
        "minWidth": 249,
        "minHeight": 171,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* ws://113.46.152.120:8039"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2ODE2ODVGM0Y1RkQ2MjUKUldRbDFsOC9YMmlCMXU0Y2NxQmYxVWRVcDFuQTNMZW1lWmx6VUJsUHpLL0JLMk0xRE8yaVdpV0EK",
      "endpoints": [
        "https://updates.nanzhaigame.cn/cpa/stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
